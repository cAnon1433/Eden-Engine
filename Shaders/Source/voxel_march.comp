// ============================================================================

// Face ambiguity test (Nielson & Hamann / the "asymptotic decider") -
// direct port of Lewiner et al.'s test_face. Returns true if the surface
// passes through (separates the same-sign diagonal corners of) the given
// face. cellValue[8] are the 8 corner densities with isoLevel already
// subtracted (so "positive" means outside/empty, matching Lewiner's own
// convention - see this file's top comment on why bit convention had to
// be flipped from this project's old cubeIndex).
bool TestFace(float cellValue[8], int face)
{
    int absFace = face < 0 ? -face : face;
    float A, B, C, D;
    if (absFace == 1)      { A = cellValue[0]; B = cellValue[4]; C = cellValue[5]; D = cellValue[1]; }
    else if (absFace == 2) { A = cellValue[1]; B = cellValue[5]; C = cellValue[6]; D = cellValue[2]; }
    else if (absFace == 3) { A = cellValue[2]; B = cellValue[6]; C = cellValue[7]; D = cellValue[3]; }
    else if (absFace == 4) { A = cellValue[3]; B = cellValue[7]; C = cellValue[4]; D = cellValue[0]; }
    else if (absFace == 5) { A = cellValue[0]; B = cellValue[3]; C = cellValue[2]; D = cellValue[1]; }
    else                   { A = cellValue[4]; B = cellValue[7]; C = cellValue[6]; D = cellValue[5]; } // absFace == 6

    float AC_BD = A * C - B * D;
    if (AC_BD > -kMCEpsilon && AC_BD < kMCEpsilon)
    {
        return face >= 0;
    }
    return (float(face) * A * AC_BD) >= 0.0;
}

// Interior/tunnel ambiguity test - direct port of Lewiner et al.'s
// test_internal. Only called for cases 4, 6, 7, 10, 12, 13, each of
// which has already resolved which face(s) it needs this for via
// TestFace above.
//
// NOTE on test==5/test==10 with a false inner condition: the reference
// Cython source (scikit-image _marching_cubes_lewiner_cy.pyx, the
// verified implementation this was ported from) has NO explicit return
// in that specific branch - it falls through to the end of an int-
// returning function. That's almost certainly equivalent to returning
// false in the compiled reference (falling off the end of a `noexcept`
// cdef int function), so that's what's implemented here - but this is
// the one spot in this port that isn't a direct line-for-line
// transcription of an explicit statement, flagging it honestly rather
// than silently guessing. It's an extremely rare sub-branch (only
// reached for specific ambiguous interior configurations within cases
// 4/6/7/10/12/13), so low-risk either way, but worth knowing if a crack
// is ever traced back to exactly this path.
bool TestInternal(int cse, int tilingConfig, int subconfig, int s, float cellValue[8])
{
    float At = 0.0, Bt = 0.0, Ct = 0.0, Dt = 0.0;
    int test = 0;

    if (cse == 4 || cse == 10)
    {
        float a = (cellValue[4] - cellValue[0]) * (cellValue[6] - cellValue[2])
                - (cellValue[7] - cellValue[3]) * (cellValue[5] - cellValue[1]);
        float b = cellValue[2] * (cellValue[4] - cellValue[0]) + cellValue[0] * (cellValue[6] - cellValue[2])
                - cellValue[1] * (cellValue[7] - cellValue[3]) - cellValue[3] * (cellValue[5] - cellValue[1]);
        float t = -b / (2.0 * a + kMCEpsilon);
        if (t < 0.0 || t > 1.0)
        {
            return s > 0;
        }

        At = cellValue[0] + (cellValue[4] - cellValue[0]) * t;
        Bt = cellValue[3] + (cellValue[7] - cellValue[3]) * t;
        Ct = cellValue[2] + (cellValue[6] - cellValue[2]) * t;
        Dt = cellValue[1] + (cellValue[5] - cellValue[1]) * t;
    }
    else // cse == 6, 7, 12, or 13
    {
        int edge = -1;
        if (cse == 6)       edge = MC_TEST6(tilingConfig, 2);
        else if (cse == 7)  edge = MC_TEST7(tilingConfig, 4);
        else if (cse == 12) edge = MC_TEST12(tilingConfig, 3);
        else                edge = MC_TILING13_5_1(tilingConfig, subconfig, 0); // cse == 13

        if (edge == 0)       { float t = cellValue[0] / (cellValue[0] - cellValue[1] + kMCEpsilon); Bt = cellValue[3] + (cellValue[2] - cellValue[3]) * t; Ct = cellValue[7] + (cellValue[6] - cellValue[7]) * t; Dt = cellValue[4] + (cellValue[5] - cellValue[4]) * t; }
        else if (edge == 1)  { float t = cellValue[1] / (cellValue[1] - cellValue[2] + kMCEpsilon); Bt = cellValue[0] + (cellValue[3] - cellValue[0]) * t; Ct = cellValue[4] + (cellValue[7] - cellValue[4]) * t; Dt = cellValue[5] + (cellValue[6] - cellValue[5]) * t; }
        else if (edge == 2)  { float t = cellValue[2] / (cellValue[2] - cellValue[3] + kMCEpsilon); Bt = cellValue[1] + (cellValue[0] - cellValue[1]) * t; Ct = cellValue[5] + (cellValue[4] - cellValue[5]) * t; Dt = cellValue[6] + (cellValue[7] - cellValue[6]) * t; }
        else if (edge == 3)  { float t = cellValue[3] / (cellValue[3] - cellValue[0] + kMCEpsilon); Bt = cellValue[2] + (cellValue[1] - cellValue[2]) * t; Ct = cellValue[6] + (cellValue[5] - cellValue[6]) * t; Dt = cellValue[7] + (cellValue[4] - cellValue[7]) * t; }
        else if (edge == 4)  { float t = cellValue[4] / (cellValue[4] - cellValue[5] + kMCEpsilon); Bt = cellValue[7] + (cellValue[6] - cellValue[7]) * t; Ct = cellValue[3] + (cellValue[2] - cellValue[3]) * t; Dt = cellValue[0] + (cellValue[1] - cellValue[0]) * t; }
        else if (edge == 5)  { float t = cellValue[5] / (cellValue[5] - cellValue[6] + kMCEpsilon); Bt = cellValue[4] + (cellValue[7] - cellValue[4]) * t; Ct = cellValue[0] + (cellValue[3] - cellValue[0]) * t; Dt = cellValue[1] + (cellValue[2] - cellValue[1]) * t; }
        else if (edge == 6)  { float t = cellValue[6] / (cellValue[6] - cellValue[7] + kMCEpsilon); Bt = cellValue[5] + (cellValue[4] - cellValue[5]) * t; Ct = cellValue[1] + (cellValue[0] - cellValue[1]) * t; Dt = cellValue[2] + (cellValue[3] - cellValue[2]) * t; }
        else if (edge == 7)  { float t = cellValue[7] / (cellValue[7] - cellValue[4] + kMCEpsilon); Bt = cellValue[6] + (cellValue[5] - cellValue[6]) * t; Ct = cellValue[2] + (cellValue[1] - cellValue[2]) * t; Dt = cellValue[3] + (cellValue[0] - cellValue[3]) * t; }
        else if (edge == 8)  { float t = cellValue[0] / (cellValue[0] - cellValue[4] + kMCEpsilon); Bt = cellValue[3] + (cellValue[7] - cellValue[3]) * t; Ct = cellValue[2] + (cellValue[6] - cellValue[2]) * t; Dt = cellValue[1] + (cellValue[5] - cellValue[1]) * t; }
        else if (edge == 9)  { float t = cellValue[1] / (cellValue[1] - cellValue[5] + kMCEpsilon); Bt = cellValue[0] + (cellValue[4] - cellValue[0]) * t; Ct = cellValue[3] + (cellValue[7] - cellValue[3]) * t; Dt = cellValue[2] + (cellValue[6] - cellValue[2]) * t; }
        else if (edge == 10) { float t = cellValue[2] / (cellValue[2] - cellValue[6] + kMCEpsilon); Bt = cellValue[1] + (cellValue[5] - cellValue[1]) * t; Ct = cellValue[0] + (cellValue[4] - cellValue[0]) * t; Dt = cellValue[3] + (cellValue[7] - cellValue[3]) * t; }
        else if (edge == 11) { float t = cellValue[3] / (cellValue[3] - cellValue[7] + kMCEpsilon); Bt = cellValue[2] + (cellValue[6] - cellValue[2]) * t; Ct = cellValue[1] + (cellValue[5] - cellValue[1]) * t; Dt = cellValue[0] + (cellValue[4] - cellValue[0]) * t; }
        At = 0.0;
    }

    if (At >= 0.0) test += 1;
    if (Bt >= 0.0) test += 2;
    if (Ct >= 0.0) test += 4;
    if (Dt >= 0.0) test += 8;

    if (test == 5)  { return (At * Ct - Bt * Dt < kMCEpsilon) ? (s > 0) : false; }  // see NOTE above
    if (test == 10) { return (At * Ct - Bt * Dt >= kMCEpsilon) ? (s > 0) : false; } // see NOTE above
    if (test == 7 || test == 11 || test == 13 || test == 14 || test == 15) { return s < 0; }
    return s > 0; // covers test == 0,1,2,3,4,6,8,9,12
}

// Faithful port of Lewiner et al.'s "the_big_switch" - together with the
// tables in MarchingCubesTables33.h, this is where the actual
// disambiguation happens. Returns the number of triangles (0 if none),
// filling triEdges[0 .. nt*3-1] with edge indices (0-11 = a standard
// cube edge, matching kEdgeCorners; 12 = the interpolated cube-center
// vertex some subcases need - see the centerPos/centerNormal computation
// in main()).
int BuildCaseTriangulation(int cse, int tilingConfig, float cellValue[8], out int triEdges[36])
{
    int subconfig = 0;

    if (cse == 1)
    {
        triEdges[0] = MC_TILING1(tilingConfig, 0);
        triEdges[1] = MC_TILING1(tilingConfig, 1);
        triEdges[2] = MC_TILING1(tilingConfig, 2);
        return 1;
    }
    else if (cse == 2)
    {
        for (int i = 0; i < 6; ++i) triEdges[i] = MC_TILING2(tilingConfig, i);
        return 2;
    }
    else if (cse == 3)
    {
        if (TestFace(cellValue, MC_TEST3(tilingConfig)))
        {
            for (int i = 0; i < 12; ++i) triEdges[i] = MC_TILING3_2(tilingConfig, i);
            return 4;
        }
        for (int i = 0; i < 6; ++i) triEdges[i] = MC_TILING3_1(tilingConfig, i);
        return 2;
    }
    else if (cse == 4)
    {
        if (TestInternal(cse, tilingConfig, subconfig, MC_TEST4(tilingConfig), cellValue))
        {
            for (int i = 0; i < 6; ++i) triEdges[i] = MC_TILING4_1(tilingConfig, i);
            return 2;
        }
        for (int i = 0; i < 18; ++i) triEdges[i] = MC_TILING4_2(tilingConfig, i);
        return 6;
    }
    else if (cse == 5)
    {
        for (int i = 0; i < 9; ++i) triEdges[i] = MC_TILING5(tilingConfig, i);
        return 3;
    }
    else if (cse == 6)
    {
        if (TestFace(cellValue, MC_TEST6(tilingConfig, 0)))
        {
            for (int i = 0; i < 15; ++i) triEdges[i] = MC_TILING6_2(tilingConfig, i);
            return 5;
        }
        if (TestInternal(cse, tilingConfig, subconfig, MC_TEST6(tilingConfig, 1), cellValue))
        {
            for (int i = 0; i < 9; ++i) triEdges[i] = MC_TILING6_1_1(tilingConfig, i);
            return 3;
        }
        for (int i = 0; i < 27; ++i) triEdges[i] = MC_TILING6_1_2(tilingConfig, i);
        return 9;
    }
    else if (cse == 7)
    {
        if (TestFace(cellValue, MC_TEST7(tilingConfig, 0))) subconfig += 1;
        if (TestFace(cellValue, MC_TEST7(tilingConfig, 1))) subconfig += 2;
        if (TestFace(cellValue, MC_TEST7(tilingConfig, 2))) subconfig += 4;

        if (subconfig == 0) { for (int i = 0; i < 9; ++i) triEdges[i] = MC_TILING7_1(tilingConfig, i); return 3; }
        if (subconfig == 1) { for (int i = 0; i < 15; ++i) triEdges[i] = MC_TILING7_2(tilingConfig, 0, i); return 5; }
        if (subconfig == 2) { for (int i = 0; i < 15; ++i) triEdges[i] = MC_TILING7_2(tilingConfig, 1, i); return 5; }
        if (subconfig == 3) { for (int i = 0; i < 27; ++i) triEdges[i] = MC_TILING7_3(tilingConfig, 0, i); return 9; }
        if (subconfig == 4) { for (int i = 0; i < 15; ++i) triEdges[i] = MC_TILING7_2(tilingConfig, 2, i); return 5; }
        if (subconfig == 5) { for (int i = 0; i < 27; ++i) triEdges[i] = MC_TILING7_3(tilingConfig, 1, i); return 9; }
        if (subconfig == 6) { for (int i = 0; i < 27; ++i) triEdges[i] = MC_TILING7_3(tilingConfig, 2, i); return 9; }
        // subconfig == 7
        if (TestInternal(cse, tilingConfig, subconfig, MC_TEST7(tilingConfig, 3), cellValue))
        {
            for (int i = 0; i < 27; ++i) triEdges[i] = MC_TILING7_4_2(tilingConfig, i);
            return 9;
        }
        for (int i = 0; i < 15; ++i) triEdges[i] = MC_TILING7_4_1(tilingConfig, i);
        return 5;
    }
    else if (cse == 8)
    {
        for (int i = 0; i < 6; ++i) triEdges[i] = MC_TILING8(tilingConfig, i);
        return 2;
    }
    else if (cse == 9)
    {
        for (int i = 0; i < 12; ++i) triEdges[i] = MC_TILING9(tilingConfig, i);
        return 4;
    }
    else if (cse == 10)
    {
        if (TestFace(cellValue, MC_TEST10(tilingConfig, 0)))
        {
            if (TestFace(cellValue, MC_TEST10(tilingConfig, 1)))
            {
                for (int i = 0; i < 12; ++i) triEdges[i] = MC_TILING10_1_1_(tilingConfig, i);
                return 4;
            }
            for (int i = 0; i < 24; ++i) triEdges[i] = MC_TILING10_2(tilingConfig, i);
            return 8;
        }
        if (TestFace(cellValue, MC_TEST10(tilingConfig, 1)))
        {
            for (int i = 0; i < 24; ++i) triEdges[i] = MC_TILING10_2_(tilingConfig, i);
            return 8;
        }
        if (TestInternal(cse, tilingConfig, subconfig, MC_TEST10(tilingConfig, 2), cellValue))
        {
            for (int i = 0; i < 12; ++i) triEdges[i] = MC_TILING10_1_1(tilingConfig, i);
            return 4;
        }
        for (int i = 0; i < 24; ++i) triEdges[i] = MC_TILING10_1_2(tilingConfig, i);
        return 8;
    }
    else if (cse == 11)
    {
        for (int i = 0; i < 12; ++i) triEdges[i] = MC_TILING11(tilingConfig, i);
        return 4;
    }
    else if (cse == 12)
    {
        if (TestFace(cellValue, MC_TEST12(tilingConfig, 0)))
        {
            if (TestFace(cellValue, MC_TEST12(tilingConfig, 1)))
            {
                for (int i = 0; i < 12; ++i) triEdges[i] = MC_TILING12_1_1_(tilingConfig, i);
                return 4;
            }
            for (int i = 0; i < 24; ++i) triEdges[i] = MC_TILING12_2(tilingConfig, i);
            return 8;
        }
        if (TestFace(cellValue, MC_TEST12(tilingConfig, 1)))
        {
            for (int i = 0; i < 24; ++i) triEdges[i] = MC_TILING12_2_(tilingConfig, i);
            return 8;
        }
        if (TestInternal(cse, tilingConfig, subconfig, MC_TEST12(tilingConfig, 2), cellValue))
        {
            for (int i = 0; i < 12; ++i) triEdges[i] = MC_TILING12_1_1(tilingConfig, i);
            return 4;
        }
        for (int i = 0; i < 24; ++i) triEdges[i] = MC_TILING12_1_2(tilingConfig, i);
        return 8;
    }
    else if (cse == 13)
    {
        if (TestFace(cellValue, MC_TEST13(tilingConfig, 0))) subconfig += 1;
        if (TestFace(cellValue, MC_TEST13(tilingConfig, 1))) subconfig += 2;
        if (TestFace(cellValue, MC_TEST13(tilingConfig, 2))) subconfig += 4;
        if (TestFace(cellValue, MC_TEST13(tilingConfig, 3))) subconfig += 8;
        if (TestFace(cellValue, MC_TEST13(tilingConfig, 4))) subconfig += 16;
        if (TestFace(cellValue, MC_TEST13(tilingConfig, 5))) subconfig += 32;

        subconfig = MC_SUBCONFIG13(subconfig);

        // Ranges below are a direct, verified simplification of the
        // reference's 46 individually-listed `elif subconfig==N:`
        // branches (each just picks a sequential row within one of the
        // tables below) - not a behavioral change, see conversation
        // history for the per-value check against the reference this
        // was collapsed from.
        if (subconfig == 0)
        {
            for (int i = 0; i < 12; ++i) triEdges[i] = MC_TILING13_1(tilingConfig, i);
            return 4;
        }
        if (subconfig >= 1 && subconfig <= 6)
        {
            int s = subconfig - 1;
            for (int i = 0; i < 18; ++i) triEdges[i] = MC_TILING13_2(tilingConfig, s, i);
            return 6;
        }
        if (subconfig >= 7 && subconfig <= 18)
        {
            int s = subconfig - 7;
            for (int i = 0; i < 30; ++i) triEdges[i] = MC_TILING13_3(tilingConfig, s, i);
            return 10;
        }
        if (subconfig >= 19 && subconfig <= 22)
        {
            int s = subconfig - 19;
            for (int i = 0; i < 36; ++i) triEdges[i] = MC_TILING13_4(tilingConfig, s, i);
            return 12;
        }
        if (subconfig >= 23 && subconfig <= 26)
        {
            int s = subconfig - 23; // reference reassigns subconfig to 0-3 here before the test_internal call
            if (TestInternal(cse, tilingConfig, s, MC_TEST13(tilingConfig, 6), cellValue))
            {
                for (int i = 0; i < 18; ++i) triEdges[i] = MC_TILING13_5_1(tilingConfig, s, i);
                return 6;
            }
            for (int i = 0; i < 30; ++i) triEdges[i] = MC_TILING13_5_2(tilingConfig, s, i);
            return 10;
        }
        if (subconfig >= 27 && subconfig <= 38)
        {
            int s = subconfig - 27;
            for (int i = 0; i < 30; ++i) triEdges[i] = MC_TILING13_3_(tilingConfig, s, i);
            return 10;
        }
        if (subconfig >= 39 && subconfig <= 44)
        {
            int s = subconfig - 39;
            for (int i = 0; i < 18; ++i) triEdges[i] = MC_TILING13_2_(tilingConfig, s, i);
            return 6;
        }
        if (subconfig == 45)
        {
            for (int i = 0; i < 12; ++i) triEdges[i] = MC_TILING13_1_(tilingConfig, i);
            return 4;
        }
        return 0; // "Impossible case 13" per the reference - should not happen
    }
    else if (cse == 14)
    {
        for (int i = 0; i < 12; ++i) triEdges[i] = MC_TILING14(tilingConfig, i);
        return 4;
    }

    return 0;
}

void main()
{
    ivec3 voxelDims = params.chunkDims * params.chunkVoxelSize;
    uint cellCount = uint(voxelDims.x) * uint(voxelDims.y) * uint(voxelDims.z);

    uint index = gl_GlobalInvocationID.x;
    if (index >= cellCount)
    {
        return;
    }

    uint cellsX = uint(voxelDims.x);
    uint cellsXY = cellsX * uint(voxelDims.y);
    uint cz = index / cellsXY;
    uint crem = index - cz * cellsXY;
    uint cy = crem / cellsX;
    uint cx = crem - cy * cellsX;
    ivec3 cell = ivec3(cx, cy, cz);

    // Which chunk owns this cell, and that chunk's flat index into the
    // per-chunk buffers - this mapping only needs to be self-consistent
    // within this shader (dirty-flag lookup and vertex-slot/indirect-
    // command lookup both use it identically); the CPU side treats
    // chunk indices as opaque slots and never needs to know which
    // spatial chunk a given index corresponds to.
    ivec3 chunkCoord = cell / params.chunkVoxelSize;
    int chunkIndex = chunkCoord.x + chunkCoord.y * params.chunkDims.x
                    + chunkCoord.z * params.chunkDims.x * params.chunkDims.y;

    if (dirtyFlags[chunkIndex] == 0u)
    {
        return;
    }

    float cornerDensity[8];
    vec3 cornerGradient[8];
    vec3 cornerPos[8];
    for (int i = 0; i < 8; ++i)
    {
        ivec3 s = cell + kCornerOffset[i];
        cornerDensity[i] = DensityAt(s);
        cornerGradient[i] = GradientAt(s);
        cornerPos[i] = vec3(s) * params.voxelSize;
    }

    // Isovalue-relative corner values, in Lewiner's own bit convention:
    // positive = outside/empty. This is the OPPOSITE of this project's
    // old cubeIndex convention (which set a bit when density was BELOW
    // isoLevel, i.e. solid) - confirmed by directly reading set_cube()
    // in the reference before porting; get this backwards and every
    // cell.index/config lookup below silently produces the complement
    // surface instead of a compile error, so it's called out here
    // explicitly rather than left implicit in the bit-shift below.
    float cellValue[8];
    int cellIndex = 0;
    for (int i = 0; i < 8; ++i)
    {
        cellValue[i] = cornerDensity[i] - params.isoLevel;
        if (cellValue[i] > 0.0)
        {
            cellIndex |= (1 << i);
        }
    }

    int cse = MC_CASES(cellIndex, 0);
    if (cse <= 0)
    {
        return; // fully inside or fully outside - no surface through this cell
    }
    int tilingConfig = MC_CASES(cellIndex, 1);

    // All 12 standard edge vertices, always computed unconditionally
    // (simpler and safer than reconstructing an edge-active bitmask from
    // the new tables - 12 cheap linear interpolations per cell is not a
    // meaningful cost here). Math unchanged from before this rewrite -
    // see this file's top comment on why Lewiner's edge interpolation is
    // algebraically equivalent to this.
    vec3 edgeVertex[12];
    vec3 edgeNormal[12];
    for (int e = 0; e < 12; ++e)
    {
        int c0 = kEdgeCorners[e].x;
        int c1 = kEdgeCorners[e].y;
        float d0 = cornerDensity[c0];
        float d1 = cornerDensity[c1];
        float t = abs(d1 - d0) > 1e-6 ? (params.isoLevel - d0) / (d1 - d0) : 0.5;
        t = clamp(t, 0.0, 1.0);

        edgeVertex[e] = mix(cornerPos[c0], cornerPos[c1], t);
        edgeNormal[e] = normalize(mix(cornerGradient[c0], cornerGradient[c1], t));
    }

    int triEdges[36];
    int nt = BuildCaseTriangulation(cse, tilingConfig, cellValue, triEdges);
    if (nt <= 0)
    {
        return;
    }

    // Center vertex some subcases need (edge index 12) - computed
    // unconditionally whenever this cell produced any triangles at all,
    // rather than scanning triEdges first to check: it's 8 divisions and
    // a weighted sum, cheap enough that "always compute, sometimes
    // unused" is simpler and safer than the alternative. Position is an
    // inverse-density-weighted centroid of the 8 corners (direct port of
    // Lewiner's calculate_center_vertex's weighting - verified
    // algebraically equivalent given it's a linear combination of corner
    // positions). Normal deliberately does NOT replicate Lewiner's own
    // internal one-directional-difference gradient scheme (self.vg[]) -
    // it reuses this shader's own proper central-difference
    // cornerGradient[], the same source every other vertex's normal
    // already comes from, which is a strictly better gradient estimate
    // than what the reference computes internally for this one purpose.
    float centerWeight[8];
    float centerWeightSum = 0.0;
    for (int i = 0; i < 8; ++i)
    {
        centerWeight[i] = 1.0 / (kMCEpsilon + abs(cellValue[i]));
        centerWeightSum += centerWeight[i];
    }
    vec3 centerPos = vec3(0.0);
    vec3 centerGradSum = vec3(0.0);
    for (int i = 0; i < 8; ++i)
    {
        centerPos += centerWeight[i] * cornerPos[i];
        centerGradSum += centerWeight[i] * cornerGradient[i];
    }
    centerPos /= centerWeightSum;
    vec3 centerNormal = normalize(centerGradSum);

    uint chunkVertexBase = uint(chunkIndex) * uint(params.maxVerticesPerChunk);

    for (int tri = 0; tri < nt * 3; tri += 3)
    {
        int i0 = triEdges[tri];
        int i1 = triEdges[tri + 1];
        int i2 = triEdges[tri + 2];

        vec3 p0 = (i0 == 12) ? centerPos : edgeVertex[i0];
        vec3 p1 = (i1 == 12) ? centerPos : edgeVertex[i1];
        vec3 p2 = (i2 == 12) ? centerPos : edgeVertex[i2];
        vec3 n0 = (i0 == 12) ? centerNormal : edgeNormal[i0];
        vec3 n1 = (i1 == 12) ? centerNormal : edgeNormal[i1];
        vec3 n2 = (i2 == 12) ? centerNormal : edgeNormal[i2];

        // Reserve 3 vertex slots for this triangle. commands[chunkIndex*4]
        // is the chunk's vertexCount field (see IndirectBuffer's layout
        // comment) - atomicAdd both allocates this triangle's slot AND
        // grows the vertex count vkCmdDrawIndirect will actually draw,
        // in one op, with no CPU involvement.
        uint slot = atomicAdd(commands[chunkIndex * 4 + 0], 3u);
        if (slot + 3u > uint(params.maxVerticesPerChunk))
        {
            // Over this chunk's worst-case capacity (kVoxelMaxVerticesPerChunk
            // in VoxelTypes.h) - undo the reservation and drop the
            // triangle rather than writing past this chunk's slot range
            // into its neighbor's. Same "known limitation, not a
            // crash" tradeoff as MAX_INSTANCES_PER_FRAME.
            // Undo the reservation via unsigned wraparound (matches
            // atomicAdd's own uint domain - avoids any ambiguity from
            // casting a negative literal to uint).
            atomicAdd(commands[chunkIndex * 4 + 0], 0u - 3u);
            continue;
        }

        // WINDING: confirmed inverted from testing (the near-camera
        // surface was being culled, showing the sphere's inside/far
        // wall instead - "always looking at the inside" is exactly what
        // wrong-handed culling looks like). Swapped i1/i2 here to flip
        // it, project-wide, in this one place - unrelated to and
        // unaffected by the table rewrite above (this is purely about
        // this pipeline's own CCW-front-face culling convention).
        WriteVertex(chunkVertexBase + slot + 0, p0 + params.origin, vec3(1.0), vec2(0.0), n0);
        WriteVertex(chunkVertexBase + slot + 1, p2 + params.origin, vec3(1.0), vec2(0.0), n2);
        WriteVertex(chunkVertexBase + slot + 2, p1 + params.origin, vec3(1.0), vec2(0.0), n1);
    }
}
