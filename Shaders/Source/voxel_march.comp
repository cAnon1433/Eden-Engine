#version 450

// Marching cubes: one invocation per CELL (a cell is 8 adjacent density
// samples forming a unit cube - see VoxelSystemGPU.h's class comment on
// why density samples are shared across chunk boundaries). Dispatched
// over every cell in the volume every call; cells belonging to a chunk
// whose dirty flag is 0 bail out immediately below - see
// VoxelSystemGPU::MarchDirtyChunks for why "dispatch everything, skip
// in-shader" was chosen over computing a tighter per-dirty-chunk region
// on the CPU.
//
// Output vertices land in THIS cell's owning chunk's reserved slot range
// of the shared vertex buffer (chunkIndex * maxVerticesPerChunk +
// atomically-allocated offset), which is also directly consumable as a
// vertex buffer by Renderer's existing triangle pipeline - see
// RendererTypes.h's Vertex layout, matched field-for-field below.
layout(local_size_x = 64) in;

// Output vertex layout: NOT a GLSL struct - see the comment below on
// why. Written/read as 11 consecutive floats per vertex:
//   [0..3)  position (vec3)
//   [3..6)  color    (vec3)
//   [6..8)  texCoord (vec2)
//   [8..11) normal   (vec3)
// matching RendererTypes::Vertex's C++ layout FIELD FOR FIELD, at the
// SAME tightly-packed byte offsets (0, 12, 24, 32) that
// Vertex::GetAttributeDescriptions() and VulkanGraphicsPipeline's vertex
// input binding (stride = sizeof(Vertex) = 44 bytes) already assume.
//
// A GLSL `struct Vertex { vec3 position; vec3 color; vec2 texCoord; vec3
// normal; }` in an std430 buffer is NOT byte-compatible with that: GLSL's
// std430 rules give vec3 a 16-byte BASE ALIGNMENT, so a vec3 immediately
// followed by ANOTHER vec3 (color right after position, normal right
// after texCoord) gets padded up to the next 16-byte boundary - unlike
// the vec3-then-scalar case (VoxelParamsGPU's push constants, which
// *is* safe - see that struct's comment), there's no absorbing scalar
// here to prevent the padding. The result is a GLSL-side vertex stride
// of 64 bytes against the pipeline's actual 44-byte stride - every
// vertex after the first reads from the wrong byte offset, and the
// misalignment compounds across the buffer. This was found and fixed
// after exactly that symptom (garbled/scattered triangles, ordinary
// meshes fine) - don't reintroduce a GLSL struct for this buffer without
// re-deriving its std430 layout by hand first.
const int kFloatsPerVertex = 11;

layout(std430, binding = 0) readonly buffer DensityBuffer { float density[]; };
layout(std430, binding = 1) buffer VertexBuffer { float vertexData[]; };
// Mirrors VkDrawIndirectCommand's 4 uint32 fields per chunk - see
// VoxelSystemGPU.cpp's IndirectCommand struct. commands[chunkIndex*4+0]
// is vertexCount, the one field this shader ever writes (via atomicAdd).
layout(std430, binding = 2) buffer IndirectBuffer { uint commands[]; };
layout(std430, binding = 3) readonly buffer EdgeTableBuffer { uint edgeTable[256]; };
layout(std430, binding = 4) readonly buffer TriTableBuffer { int triTable[256 * 16]; };
layout(std430, binding = 5) readonly buffer DirtyFlagsBuffer { uint dirtyFlags[]; };

layout(push_constant) uniform VoxelParams
{
    vec3 origin;
    float voxelSize;

    ivec3 sampleDims;
    int chunkVoxelSize;

    ivec3 chunkDims;
    int maxVerticesPerChunk;

    float isoLevel;
    int _pad0;
    int _pad1;
    int _pad2;
} params;

// Standard cube corner offsets (Bourke/Lorensen-Cline numbering, the
// same convention kMarchingCubesEdgeTable/kMarchingCubesTriTable were
// built against - do not renumber these without regenerating the
// tables to match).
const ivec3 kCornerOffset[8] = ivec3[8](
    ivec3(0, 0, 0), ivec3(1, 0, 0), ivec3(1, 1, 0), ivec3(0, 1, 0),
    ivec3(0, 0, 1), ivec3(1, 0, 1), ivec3(1, 1, 1), ivec3(0, 1, 1)
);

// Which two corners each of the 12 cube edges connects - same
// convention the reference edge/tri tables assume.
const ivec2 kEdgeCorners[12] = ivec2[12](
    ivec2(0, 1), ivec2(1, 2), ivec2(2, 3), ivec2(3, 0),
    ivec2(4, 5), ivec2(5, 6), ivec2(6, 7), ivec2(7, 4),
    ivec2(0, 4), ivec2(1, 5), ivec2(2, 6), ivec2(3, 7)
);

uint SampleIndex(ivec3 s)
{
    return uint(s.x) + uint(s.y) * uint(params.sampleDims.x)
         + uint(s.z) * uint(params.sampleDims.x) * uint(params.sampleDims.y);
}

float DensityAt(ivec3 s)
{
    ivec3 clamped = clamp(s, ivec3(0), params.sampleDims - ivec3(1));
    return density[SampleIndex(clamped)];
}

// Central-difference gradient of the density field at a sample point -
// points from solid toward empty (density increases outward, matching
// Physics/SDF.h's sign convention), which is exactly the outward
// surface normal a signed distance field's gradient gives you for free.
// Clamped neighbor sampling (via DensityAt) means this stays well-
// defined at the volume's own boundary samples too.
vec3 GradientAt(ivec3 s)
{
    float dx = DensityAt(s + ivec3(1, 0, 0)) - DensityAt(s - ivec3(1, 0, 0));
    float dy = DensityAt(s + ivec3(0, 1, 0)) - DensityAt(s - ivec3(0, 1, 0));
    float dz = DensityAt(s + ivec3(0, 0, 1)) - DensityAt(s - ivec3(0, 0, 1));
    return vec3(dx, dy, dz);
}

// vertexIndex is a plain vertex count (chunk's base slot + local offset),
// NOT a float index - this does that conversion once, in the one place
// that needs to, so nothing else has to remember kFloatsPerVertex.
void WriteVertex(uint vertexIndex, vec3 position, vec3 color, vec2 texCoord, vec3 normal)
{
    uint base = vertexIndex * uint(kFloatsPerVertex);
    vertexData[base + 0] = position.x;
    vertexData[base + 1] = position.y;
    vertexData[base + 2] = position.z;
    vertexData[base + 3] = color.x;
    vertexData[base + 4] = color.y;
    vertexData[base + 5] = color.z;
    vertexData[base + 6] = texCoord.x;
    vertexData[base + 7] = texCoord.y;
    vertexData[base + 8] = normal.x;
    vertexData[base + 9] = normal.y;
    vertexData[base + 10] = normal.z;
}

void main()
{
    ivec3 voxelDims = params.chunkDims * params.chunkVoxelSize;
    uint cellCount = uint(voxelDims.x) * uint(voxelDims.y) * uint(voxelDims.z);

    uint index = gl_GlobalInvocationID.x;
    if (index >= cellCount)
    {
        return;
    }

    uint cellsX = uint(voxelDims.x);
    uint cellsXY = cellsX * uint(voxelDims.y);
    uint cz = index / cellsXY;
    uint crem = index - cz * cellsXY;
    uint cy = crem / cellsX;
    uint cx = crem - cy * cellsX;
    ivec3 cell = ivec3(cx, cy, cz);

    // Which chunk owns this cell, and that chunk's flat index into the
    // per-chunk buffers - this mapping only needs to be self-consistent
    // within this shader (dirty-flag lookup and vertex-slot/indirect-
    // command lookup both use it identically); the CPU side treats
    // chunk indices as opaque slots and never needs to know which
    // spatial chunk a given index corresponds to.
    ivec3 chunkCoord = cell / params.chunkVoxelSize;
    int chunkIndex = chunkCoord.x + chunkCoord.y * params.chunkDims.x
                    + chunkCoord.z * params.chunkDims.x * params.chunkDims.y;

    if (dirtyFlags[chunkIndex] == 0u)
    {
        return;
    }

    float cornerDensity[8];
    vec3 cornerGradient[8];
    for (int i = 0; i < 8; ++i)
    {
        ivec3 s = cell + kCornerOffset[i];
        cornerDensity[i] = DensityAt(s);
        cornerGradient[i] = GradientAt(s);
    }

    int cubeIndex = 0;
    for (int i = 0; i < 8; ++i)
    {
        if (cornerDensity[i] < params.isoLevel)
        {
            cubeIndex |= (1 << i);
        }
    }

    if (edgeTable[cubeIndex] == 0u)
    {
        return; // fully inside or fully outside - no surface through this cell
    }

    vec3 edgeVertex[12];
    vec3 edgeNormal[12];
    for (int e = 0; e < 12; ++e)
    {
        if ((edgeTable[cubeIndex] & (1u << e)) == 0u)
        {
            continue;
        }
        int c0 = kEdgeCorners[e].x;
        int c1 = kEdgeCorners[e].y;
        float d0 = cornerDensity[c0];
        float d1 = cornerDensity[c1];
        float t = abs(d1 - d0) > 1e-6 ? (params.isoLevel - d0) / (d1 - d0) : 0.5;
        t = clamp(t, 0.0, 1.0);

        vec3 p0 = vec3(cell + kCornerOffset[c0]) * params.voxelSize;
        vec3 p1 = vec3(cell + kCornerOffset[c1]) * params.voxelSize;
        edgeVertex[e] = mix(p0, p1, t);
        edgeNormal[e] = normalize(mix(cornerGradient[c0], cornerGradient[c1], t));
    }

    uint chunkVertexBase = uint(chunkIndex) * uint(params.maxVerticesPerChunk);

    for (int tri = 0; tri < 15; tri += 3)
    {
        int i0 = triTable[cubeIndex * 16 + tri];
        if (i0 < 0)
        {
            break;
        }
        int i1 = triTable[cubeIndex * 16 + tri + 1];
        int i2 = triTable[cubeIndex * 16 + tri + 2];

        // Reserve 3 vertex slots for this triangle. commands[chunkIndex*4]
        // is the chunk's vertexCount field (see IndirectBuffer's layout
        // comment) - atomicAdd both allocates this triangle's slot AND
        // grows the vertex count vkCmdDrawIndirect will actually draw,
        // in one op, with no CPU involvement.
        uint slot = atomicAdd(commands[chunkIndex * 4 + 0], 3u);
        if (slot + 3u > uint(params.maxVerticesPerChunk))
        {
            // Over this chunk's worst-case capacity (kVoxelMaxVerticesPerChunk
            // in VoxelTypes.h) - undo the reservation and drop the
            // triangle rather than writing past this chunk's slot range
            // into its neighbor's. Same "known limitation, not a
            // crash" tradeoff as MAX_INSTANCES_PER_FRAME.
            atomicAdd(commands[chunkIndex * 4 + 0], uint(-3));
            continue;
        }

        // WINDING: confirmed inverted from testing (the near-camera
        // surface was being culled, showing the sphere's inside/far
        // wall instead - "always looking at the inside" is exactly what
        // wrong-handed culling looks like). Swapped i1/i2 here to flip
        // it, project-wide, in this one place - see kEdgeCorners/
        // triTable's construction for why the raw table order came out
        // opposite-handed from what this pipeline's CCW-front-face
        // culling expects.
        WriteVertex(chunkVertexBase + slot + 0, edgeVertex[i0] + params.origin, vec3(1.0), vec2(0.0), edgeNormal[i0]);
        WriteVertex(chunkVertexBase + slot + 1, edgeVertex[i2] + params.origin, vec3(1.0), vec2(0.0), edgeNormal[i2]);
        WriteVertex(chunkVertexBase + slot + 2, edgeVertex[i1] + params.origin, vec3(1.0), vec2(0.0), edgeNormal[i1]);
    }
}
