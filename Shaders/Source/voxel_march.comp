#version 450

// Marching cubes: one invocation per CELL (a cell is 8 adjacent density
// samples forming a unit cube - see VoxelSystemGPU.h's class comment on
// why density samples are shared across chunk boundaries). Dispatched
// over every cell in the volume every call; cells belonging to a chunk
// whose dirty flag is 0 bail out immediately below - see
// VoxelSystemGPU::MarchDirtyChunks for why "dispatch everything, skip
// in-shader" was chosen over computing a tighter per-dirty-chunk region
// on the CPU.
//
// Output vertices land in THIS cell's owning chunk's reserved slot range
// of the shared vertex buffer (chunkIndex * maxVerticesPerChunk +
// atomically-allocated offset), which is also directly consumable as a
// vertex buffer by Renderer's existing triangle pipeline - see
// RendererTypes.h's Vertex layout, matched field-for-field below.
//
// TRIANGULATION ALGORITHM (rewritten - was the plain Lorensen & Cline
// 1987 table, which has NO ambiguous-face disambiguation and was the
// confirmed root cause of the marching-cubes crack bug): this now ports
// Lewiner, Lopes, Vieira & Tavares' "Marching Cubes 33" algorithm
// (Journal of Graphics Tools 8(2), 2003), specifically the verified,
// widely-used implementation from scikit-image's
// _marching_cubes_lewiner_cy.pyx (BSD-licensed, fetched from
// github.com/scikit-image/scikit-image tag v0.24.0 and mechanically
// converted - not hand-transcribed - into the table blob in
// MarchingCubesTables33.h; see that file's header comment for the exact
// provenance and the conversion script's own verification notes).
//
// Two things confirmed by direct comparison against that reference
// before porting (see conversation history, not repeated in full here):
// (1) Lewiner's v0..v7 corner numbering and 0-11 edge numbering are
// BOTH identical to this project's existing kCornerOffset/kEdgeCorners
// convention below - no remapping needed. (2) Lewiner's edge-crossing
// interpolation is algebraically equivalent to the plain linear
// interpolation this shader already used - so that part (edgeVertex/
// edgeNormal below) is UNCHANGED from before. Only the case/table
// dispatch that decides WHICH edges make up WHICH triangles - the part
// that actually caused the ambiguous-face cracks - is new.
layout(local_size_x = 64) in;

// Output vertex layout: NOT a GLSL struct - see the comment below on
// why. Written/read as 11 consecutive floats per vertex:
//   [0..3)  position (vec3)
//   [3..6)  color    (vec3)
//   [6..8)  texCoord (vec2)
//   [8..11) normal   (vec3)
// matching RendererTypes::Vertex's C++ layout FIELD FOR FIELD, at the
// SAME tightly-packed byte offsets (0, 12, 24, 32) that
// Vertex::GetAttributeDescriptions() and VulkanGraphicsPipeline's vertex
// input binding (stride = sizeof(Vertex) = 44 bytes) already assume.
//
// A GLSL `struct Vertex { vec3 position; vec3 color; vec2 texCoord; vec3
// normal; }` in an std430 buffer is NOT byte-compatible with that: GLSL's
// std430 rules give vec3 a 16-byte BASE ALIGNMENT, so a vec3 immediately
// followed by ANOTHER vec3 (color right after position, normal right
// after texCoord) gets padded up to the next 16-byte boundary - unlike
// the vec3-then-scalar case (VoxelParamsGPU's push constants, which
// *is* safe - see that struct's comment), there's no absorbing scalar
// here to prevent the padding. The result is a GLSL-side vertex stride
// of 64 bytes against the pipeline's actual 44-byte stride - every
// vertex after the first reads from the wrong byte offset, and the
// misalignment compounds across the buffer. This was found and fixed
// after exactly that symptom (garbled/scattered triangles, ordinary
// meshes fine) - don't reintroduce a GLSL struct for this buffer without
// re-deriving its std430 layout by hand first.
const int kFloatsPerVertex = 11;

// Binding 0 is the FULL shared density buffer, not a per-volume sub-
// range like it used to be - ghost-sample neighbor reads (see
// DensityAt) need to be able to reach into an adjacent terrain tile's
// region of this same buffer, which a sub-range view can't do. Every
// density read - including this volume's own in-range samples - goes
// through params.ownDensityElementOffset now; nothing is implicit via
// the binding anymore.
layout(std430, binding = 0) readonly buffer DensityBuffer { float density[]; };
layout(std430, binding = 1) buffer VertexBuffer { float vertexData[]; };
// Mirrors VkDrawIndirectCommand's 4 uint32 fields per chunk - see
// VoxelSystemGPU.cpp's IndirectCommand struct. commands[chunkIndex*4+0]
// is vertexCount, the one field this shader ever writes (via atomicAdd).
layout(std430, binding = 2) buffer IndirectBuffer { uint commands[]; };
// Single flat table blob replacing the old separate edge-table/tri-table
// bindings - see MarchingCubesTables33.h for what's packed in here and
// why one buffer instead of ~46 (MoltenVK's maxPerStageDescriptorStorageBuffers=31
// ceiling, already a hard constraint elsewhere in this project, made
// "one binding per table" a non-starter).
layout(std430, binding = 3) readonly buffer MC33TableBuffer { int mc33[]; };
layout(std430, binding = 4) readonly buffer DirtyFlagsBuffer { uint dirtyFlags[]; };

layout(push_constant) uniform VoxelParams
{
    vec3 origin;
    float voxelSize;

    ivec3 sampleDims;
    int chunkVoxelSize;

    ivec3 chunkDims;
    int maxVerticesPerChunk;

    float isoLevel;
    // Own offset + up to 4 horizontal neighbor offsets into the shared
    // density buffer (binding 0 is now bound as the FULL shared buffer,
    // not a per-volume sub-range - see RegisterVolume's comment) -
    // ghost-sample support for gradient continuity across terrain tile
    // boundaries. -1 = no neighbor in that direction. See DensityAt.
    int ownDensityElementOffset;
    int neighborDensityOffsetNegX;
    int neighborDensityOffsetPosX;

    int neighborDensityOffsetNegZ;
    int neighborDensityOffsetPosZ;
    int _pad0;
    int _pad1;
} params;

// Standard cube corner offsets (Bourke/Lorensen-Cline numbering - and,
// confirmed by direct comparison, also exactly Lewiner et al.'s own v0..v7
// numbering, so the MC33 table blob can be used against these same
// corners with no remapping).
const ivec3 kCornerOffset[8] = ivec3[8](
    ivec3(0, 0, 0), ivec3(1, 0, 0), ivec3(1, 1, 0), ivec3(0, 1, 0),
    ivec3(0, 0, 1), ivec3(1, 0, 1), ivec3(1, 1, 1), ivec3(0, 1, 1)
);

// Which two corners each of the 12 cube edges connects - same
// convention the MC33 tables assume (also confirmed identical to
// Lewiner et al.'s own edge numbering by direct comparison - see this
// file's top comment).
const ivec2 kEdgeCorners[12] = ivec2[12](
    ivec2(0, 1), ivec2(1, 2), ivec2(2, 3), ivec2(3, 0),
    ivec2(4, 5), ivec2(5, 6), ivec2(6, 7), ivec2(7, 4),
    ivec2(0, 4), ivec2(1, 5), ivec2(2, 6), ivec2(3, 7)
);

// Small-number guard against divide-by-zero in the tests below. The
// reference (float64 Cython) uses float64 machine epsilon (~1.1e-16),
// which is meaningless as a guard once everything here is float32 (any
// float32 value added to something of normal magnitude just vanishes at
// that scale) - using this shader's own existing float32 edge-interpolation
// epsilon (see edgeVertex's t computation below) instead, for an epsilon
// that's actually load-bearing at this precision.
const float kMCEpsilon = 1e-6;

uint SampleIndex(ivec3 s)
{
    return uint(s.x) + uint(s.y) * uint(params.sampleDims.x)
         + uint(s.z) * uint(params.sampleDims.x) * uint(params.sampleDims.y);
}

// Ghost-sample density read. For an in-range coordinate this is exactly
// what it always was (just with an explicit offset add now that binding
// 0 is the full shared buffer - see its own comment). For a coordinate
// exactly 1 past this volume's own edge on the X or Z axis, and ONLY
// when a neighbor is configured for that direction, this reads the
// REAL sample from the neighboring terrain tile's own region of the
// same buffer instead of clamping to this volume's edge.
//
// Confirmed by direct measurement (not assumed) that this is worth
// doing: SampleSignedDistance queried at the exact same world position
// from two adjacent tiles was returning meaningfully different density
// (some measured over 2x apart) - not from the carve being applied
// inconsistently (verified that isn't the cause - both tiles' CSG
// carve values agree at their own true corresponding samples), but from
// each tile's OWN gradient/interpolation only ever having its own data
// to work with, one-sided at the very edge instead of centered. This
// is what that fixes - it does NOT change where any vertex sits, only
// what a boundary cell's normal (and any interpolation reaching past
// the edge) is computed from.
//
// Never needs a DIAGONAL neighbor: this is only ever called with one
// axis offset by 1 from an otherwise-valid corner coordinate (corner
// sampling itself never leaves [0, sampleDims-1] - see cornerDensity's
// own loop in main() - only GradientAt's +-1 central difference can),
// so X and Z are never simultaneously out of range in a single call.
float DensityAt(ivec3 s)
{
    ivec3 local = s;
    int densityBase = params.ownDensityElementOffset;

    if (local.x < 0)
    {
        if (params.neighborDensityOffsetNegX >= 0)
        {
            local.x = params.sampleDims.x - 1 + local.x; // -1 -> sampleDims.x-2 (that neighbor's own second-to-last sample - see this file's header comment on why not its last)
            densityBase = params.neighborDensityOffsetNegX;
        }
        else
        {
            local.x = 0;
        }
    }
    else if (local.x >= params.sampleDims.x)
    {
        if (params.neighborDensityOffsetPosX >= 0)
        {
            local.x = local.x - params.sampleDims.x + 1; // sampleDims.x -> 1 (that neighbor's own second sample)
            densityBase = params.neighborDensityOffsetPosX;
        }
        else
        {
            local.x = params.sampleDims.x - 1;
        }
    }

    if (local.z < 0)
    {
        if (params.neighborDensityOffsetNegZ >= 0)
        {
            local.z = params.sampleDims.z - 1 + local.z;
            densityBase = params.neighborDensityOffsetNegZ;
        }
        else
        {
            local.z = 0;
        }
    }
    else if (local.z >= params.sampleDims.z)
    {
        if (params.neighborDensityOffsetPosZ >= 0)
        {
            local.z = local.z - params.sampleDims.z + 1;
            densityBase = params.neighborDensityOffsetPosZ;
        }
        else
        {
            local.z = params.sampleDims.z - 1;
        }
    }

    local.y = clamp(local.y, 0, params.sampleDims.y - 1); // terrain tiles never neighbor vertically - Y always just clamps, same as before

    return density[densityBase + int(SampleIndex(local))];
}

// Central-difference gradient of the density field at a sample point -
// points from solid toward empty (density increases outward, matching
// Physics/SDF.h's sign convention), which is exactly the outward
// surface normal a signed distance field's gradient gives you for free.
// Clamped neighbor sampling (via DensityAt) means this stays well-
// defined at the volume's own boundary samples too.
vec3 GradientAt(ivec3 s)
{
    float dx = DensityAt(s + ivec3(1, 0, 0)) - DensityAt(s - ivec3(1, 0, 0));
    float dy = DensityAt(s + ivec3(0, 1, 0)) - DensityAt(s - ivec3(0, 1, 0));
    float dz = DensityAt(s + ivec3(0, 0, 1)) - DensityAt(s - ivec3(0, 0, 1));
    return vec3(dx, dy, dz);
}

// vertexIndex is a plain vertex count (chunk's base slot + local offset),
// NOT a float index - this does that conversion once, in the one place
// that needs to, so nothing else has to remember kFloatsPerVertex.
void WriteVertex(uint vertexIndex, vec3 position, vec3 color, vec2 texCoord, vec3 normal)
{
    uint base = vertexIndex * uint(kFloatsPerVertex);
    vertexData[base + 0] = position.x;
    vertexData[base + 1] = position.y;
    vertexData[base + 2] = position.z;
    vertexData[base + 3] = color.x;
    vertexData[base + 4] = color.y;
    vertexData[base + 5] = color.z;
    vertexData[base + 6] = texCoord.x;
    vertexData[base + 7] = texCoord.y;
    vertexData[base + 8] = normal.x;
    vertexData[base + 9] = normal.y;
    vertexData[base + 10] = normal.z;
}

