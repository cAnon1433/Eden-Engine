#version 450

// Pressure + viscosity force accumulation, one invocation per particle -
// GPU mirror of ParticleSystem::ComputeForces. Same near-coincident-
// particle fallback as the CPU version (deterministic pair-hash pseudo-
// direction, antisymmetric by i/j order) - see that function's .cpp
// comment for why this exists (prevents two particles landing on the
// exact same point from staying stuck together with zero repulsion).
layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer PositionsBuffer { vec4 positions[]; };
layout(std430, binding = 1) readonly buffer VelocitiesBuffer { vec4 velocities[]; };
layout(std430, binding = 2) readonly buffer DensitiesBuffer { float densities[]; };
layout(std430, binding = 3) readonly buffer PressuresBuffer { float pressures[]; };
layout(std430, binding = 4) buffer ForcesBuffer { vec4 forces[]; };
layout(std430, binding = 5) readonly buffer CellCountsBuffer { uint cellCounts[]; };
layout(std430, binding = 6) readonly buffer CellBucketsBuffer { uint cellBuckets[]; };

// Heat/cooldown state - read-only here, only integrate.comp writes it.
// This shader piggybacks a heat-conduction pass onto the SPH neighbor
// loop it already has to do for pressure/viscosity (see main() below) -
// see forces[i].w's comment for why the result rides along in the
// otherwise-unused w component of ForcesBuffer instead of needing its
// own buffer/binding.
layout(std430, binding = 8) readonly buffer HeatBuffer { float heat[]; };

// Chemical ID system (base build) - see ParticleGPUTypes.h's
// ChemicalPropertiesGPU comment. Byte-identical to that C++ struct, same
// as particle_density.comp's copy of this struct (hand-synced, same
// convention SimParams already uses).
struct ChemicalProperties
{
    float mass;
    float restDensity;
    float viscosity;
    float stiffness;         // unused in this shader - already baked into pressures[] by particle_density.comp
    float hardeningThreshold; // unused in this shader
    float hardenedDensity;    // unused in this shader
    float conductivity;       // inert
    float cohesion;           // load-bearing here - see main()'s cohesionIJ
    vec4 baseColor;           // unused in this shader
};

layout(std430, binding = 10) readonly buffer ChemicalIdBuffer { uint chemicalIds[]; };
// Color diffusion (see main()'s "Color diffusion" block below) - Colors
// is read-only here (integrate.comp owns writing it, same read/write
// split heat already uses), ColorsAvg is this shader's OWN scratch
// output, mirroring exactly how forces[i].w carries neighborAvgHeat to
// integrate.comp - just with its own buffer instead of a spare
// component, since a color needs three floats and ForcesBuffer has none
// spare (xyz already force, w already heat).
layout(std430, binding = 11) readonly buffer ColorsBuffer { vec4 colors[]; };
layout(std430, binding = 12) buffer ColorsAvgBuffer { vec4 colorsAvg[]; };
layout(std430, binding = 13) readonly buffer ChemicalPropertiesBuffer { ChemicalProperties chemicals[]; };

layout(push_constant) uniform SimParams
{
    uint particleCount;
    uint numColliders;
    uint hashTableSize;
    uint maxPerCell;
    float h;
    float h2;
    float mass;
    float restDensity;
    float stiffness;
    float gamma;
    float viscosity;
    float dt;
    float cellSize;
    float particleRadius;
    float boundaryRestitution;
    float maxAcceleration;
    uint maxSweepIterations;
    float heatDecayRate;      // was _pad0
    float heatColdMultiplier; // was _pad1
    float boundaryFriction;   // was _pad2
    vec4 gravity;

    // Read here too now (see main() below) as well as by
    // particle_integrate.comp and particle_build_grid.comp - not just
    // present for layout matching anymore.
    float voidKillY;

    // Cohesion coefficient - see CohesionKernel/main() below for the
    // force this actually drives, and ParticleGPUTypes.h's
    // SimParamsGPU::cohesion comment for why it exists. 0 = off.
    float cohesion;
} sim;

const float PI = 3.14159265358979323846;

// Akinci et al. 2013 ("Versatile Surface Tension and Adhesion for SPH
// Fluids") cohesion spline. Unlike Poly6/Spiky above, this is
// deliberately NOT a density-estimation kernel - it's shaped to give a
// short-range REPULSIVE lobe near r=0 (preventing particle interpenetration
// from the attraction below) and an ATTRACTIVE lobe out toward r=h (pulling
// free-surface particles back toward the body instead of letting them fly
// off as separate droplets - see main()'s use of this for what "attractive"
// means in an all-positive kernel: the minus sign lives in the force
// direction, not here).
float CohesionKernel(float r, float h)
{
    if (r <= 0.0 || r > h)
    {
        return 0.0;
    }
    float coefficient = 32.0 / (PI * pow(h, 9.0));
    float term = (h - r) * (h - r) * (h - r) * r * r * r;
    if (2.0 * r > h)
    {
        return coefficient * term;
    }
    float h6 = pow(h, 6.0);
    return coefficient * (2.0 * term - h6 / 64.0);
}

// grad W(r,h) = -45 / (pi * h^6) * (h - r)^2 * (rVec / r), for 0 < r <= h
vec3 SpikyGradient(vec3 rVec, float r, float h)
{
    if (r <= 0.0 || r > h)
    {
        return vec3(0.0);
    }
    float coefficient = -45.0 / (PI * pow(h, 6.0));
    float diff = h - r;
    return coefficient * diff * diff * (rVec / r);
}

// lap W(r,h) = 45 / (pi * h^6) * (h - r), for 0 <= r <= h
float ViscosityLaplacian(float r, float h)
{
    if (r > h)
    {
        return 0.0;
    }
    float coefficient = 45.0 / (PI * pow(h, 6.0));
    return coefficient * (h - r);
}

uint HashCell(ivec3 cell)
{
    uint h = (uint(cell.x) * 73856093u) ^ (uint(cell.y) * 19349663u) ^ (uint(cell.z) * 83492791u);
    return h & (sim.hashTableSize - 1u);
}

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= sim.particleCount)
    {
        return;
    }

    vec3 pi = positions[i].xyz;

    // Void-killed particles never got inserted into the grid (see
    // particle_build_grid.comp's own check) and particle_integrate.comp
    // returns before ever reading forces[i]/heat[i] for them (see its
    // void-kill early-exit) - leaving this buffer's entry stale for
    // them is harmless, and skipping the wasted 27-cell neighbor scan
    // here is real, additive savings on top of the atomic-contention
    // fix in particle_build_grid.comp.
    if (pi.y < sim.voidKillY)
    {
        return;
    }

    vec3 vi = velocities[i].xyz;
    float pressureI = pressures[i];
    float heatI = heat[i];
    uint chemI = chemicalIds[i];
    vec3 colorI = colors[i].rgb;

    vec3 pressureForce = vec3(0.0);
    vec3 viscosityForce = vec3(0.0);
    vec3 cohesionForce = vec3(0.0);
    float densityI = densities[i];

    // Heat-conduction accumulators - see forces[i].w's comment below.
    // Unconditional now for every particle - see GPU_HEAT_NOT_MELTED's
    // comment for what "only touched when part of the melt system" used
    // to mean here and why that distinction no longer exists.
    float heatWeightedSum = 0.0;
    float heatWeightTotal = 0.0;

    // Color-diffusion accumulators - see "Color diffusion" below. Same
    // unconditional shape as heat above now - color mixing is a property
    // of ALL matter, not just melted matter, and was never gated the way
    // heat used to be.
    vec3 colorWeightedSum = vec3(0.0);
    float colorWeightTotal = 0.0;

    ivec3 cell = ivec3(floor(pi / sim.cellSize));
    const float kMinSeparation = 1e-4;

    for (int dz = -1; dz <= 1; ++dz)
    for (int dy = -1; dy <= 1; ++dy)
    for (int dx = -1; dx <= 1; ++dx)
    {
        uint hash = HashCell(cell + ivec3(dx, dy, dz));
        uint count = min(cellCounts[hash], sim.maxPerCell);
        uint base = hash * sim.maxPerCell;

        for (uint s = 0u; s < count; ++s)
        {
            uint j = cellBuckets[base + s];
            if (j == i)
            {
                continue;
            }

            vec3 rVec = pi - positions[j].xyz;
            float r = length(rVec);
            if (r > sim.h)
            {
                continue;
            }

            vec3 effectiveRVec = rVec;
            float effectiveR = r;

            if (r < kMinSeparation)
            {
                // Deterministic pair-hash direction, antisymmetric by
                // i/j order - see particle_force.comp's file comment /
                // ParticleSystem::ComputeForces' identical CPU logic.
                uint a = min(i, j);
                uint b = max(i, j);
                uint hash2 = (a * 73856093u) ^ (b * 19349663u);
                float theta = float(hash2 % 6283u) / 1000.0;
                float z = float((hash2 / 6283u) % 2000u) / 1000.0 - 1.0;
                float ringRadius = sqrt(max(0.0, 1.0 - z * z));
                vec3 direction = vec3(ringRadius * cos(theta), ringRadius * sin(theta), z);
                if (i > j)
                {
                    direction = -direction;
                }

                effectiveR = kMinSeparation;
                effectiveRVec = direction * effectiveR;
            }

            float rhoJ = densities[j];
            if (rhoJ <= 0.0)
            {
                continue;
            }

            uint chemJ = chemicalIds[j];
            float massJ = chemicals[chemJ].mass;

            // Symmetric pressure-force form (each particle's OWN
            // pressure/density-squared term, not the previous single-
            // global-mass approximation) - the standard, momentum-
            // conserving multi-material SPH pressure gradient (Müller
            // 2003's own citation for it). This matters now specifically
            // BECAUSE mass/density can differ per chemical: the old
            // "sim.mass * (pI+pJ)/(2*rhoJ)" form was only exactly correct
            // when every particle shared one mass/density, which was
            // true before this base build and is no longer guaranteed.
            float pressureJ = pressures[j];
            vec3 gradW = SpikyGradient(effectiveRVec, effectiveR, sim.h);
            pressureForce -= massJ * (pressureI / (densityI * densityI) + pressureJ / (rhoJ * rhoJ)) * gradW;

            // Per-pair viscosity - simple average of the two chemicals'
            // own viscosity (viscosity is fundamentally a PAIRWISE
            // property of an interaction, not something one particle
            // "has" in isolation - there's no more principled single
            // value to pick between two different chemicals meeting).
            // Fully per-chemical now - no global multiplier on top
            // anymore (there used to be one, sim.viscosity/the old
            // "Viscosity" ImGui slider - removed once every chemical got
            // its own editable viscosity, so there was no longer a
            // meaningful DIFFERENCE between "the global knob" and "just
            // edit the chemical", and keeping both was two controls
            // doing overlapping jobs).
            vec3 vj = velocities[j].xyz;
            float lapW = ViscosityLaplacian(effectiveR, sim.h);
            float viscosityIJ = 0.5 * (chemicals[chemI].viscosity + chemicals[chemJ].viscosity);
            viscosityForce += massJ * viscosityIJ * (vj - vi) / rhoJ * lapW;

            // Cohesion (surface tension) - see CohesionKernel's comment
            // above. Per-chemical now (average of both particles' own
            // cohesion, same pairwise-average pattern as viscosity just
            // above) - moved off the old global sim.cohesion once
            // "differing properties per chemical" became the explicit
            // goal; see ChemicalPropertiesGPU::cohesion's own comment for
            // why it was kept global originally and why that stopped
            // making sense. massI*massJ replaces the old sim.mass*sim.mass -
            // still correct now that mass genuinely varies per particle.
            // kij is Akinci's density-correction factor: without it,
            // particles in a denser-than-rest region (e.g. the bottom of
            // a resting pool) would cohere MORE strongly than particles
            // at rest density, which is backwards - cohesion should hold
            // a free surface together, not add extra clumping force
            // where the fluid is already well-packed.
            float cohesionIJ = 0.5 * (chemicals[chemI].cohesion + chemicals[chemJ].cohesion);
            if (cohesionIJ > 0.0)
            {
                float massI = chemicals[chemI].mass;
                float kij = 2.0 * sim.restDensity / (densityI + rhoJ);
                float cKernel = CohesionKernel(effectiveR, sim.h);
                cohesionForce -= cohesionIJ * massI * massJ * kij * cKernel
                                * (effectiveRVec / effectiveR);
            }

            // Color diffusion - reuses lapW exactly like heat conduction
            // below does (same Laplacian-smoothing role, same neighbor
            // set, applied to a different per-particle scalar/vector).
            // Unconditional (no heatI>=0-style gate) - every particle's
            // color mixes with its neighbors', not just melt-system
            // particles. This is the mechanism behind "drop a dark
            // liquid into a light one and watch it spread": each
            // particle's displayed color is continuously pulled toward
            // its SPH neighborhood's weighted-average color, exactly the
            // same miscible-fluid technique heat diffusion already
            // proved out for a scalar - just applied to vec3 here.
            vec3 colorJ = colors[j].rgb;
            colorWeightedSum += colorJ * lapW;
            colorWeightTotal += lapW;

            // Heat conduction toward SPH neighbors (same radius h
            // pressure/viscosity already use - "close enough to
            // interact" is a reasonable, already-computed proxy for
            // "resting against/near each other"). Reuses lapW itself as
            // the falloff weight, same Laplacian-smoothing role it plays
            // for viscosity's velocity diffusion - heat diffusion is the
            // same kind of process on a scalar instead of a vector, not
            // a different mechanism. Unconditional now - every particle
            // conducts heat with every neighbor regardless of chemical or
            // origin (see GPU_HEAT_NOT_MELTED's comment for what this
            // replaced: heat[j] used to be checked against a "part of the
            // melt system" sentinel before contributing here, but there's
            // no such distinction left to check).
            float heatJ = heat[j];
            heatWeightedSum += heatJ * lapW;
            heatWeightTotal += lapW;
        }
    }

    // viscosityForce is NOT rescaled by sim.viscosity here anymore -
    // that global multiplier is now applied per-pair, inside the loop
    // above (see viscosityIJ), alongside each pair's own chemical
    // viscosity average. Rescaling it again here would double-apply it.

    // Gravity NOT added here - applied as an acceleration in
    // particle_integrate.comp, same convention as the CPU version.
    //
    // forces[i].w carries this particle's SPH-neighborhood-weighted
    // average heat (not a force component - .w was always unused here,
    // see the struct's own w=0.0 in the old version of this line) -
    // particle_integrate.comp reads it back to pull heatI toward it each
    // step (see that shader's "Heat conduction" block). Falls back to
    // heatI itself (a no-op pull) when there were no eligible neighbors
    // in range, e.g. an isolated melted particle with nothing nearby to
    // conduct with.
    float neighborAvgHeat = heatWeightTotal > 0.0 ? (heatWeightedSum / heatWeightTotal) : heatI;
    forces[i] = vec4(pressureForce + viscosityForce + cohesionForce, neighborAvgHeat);

    // colorsAvg[i] carries this particle's SPH-neighborhood-weighted
    // average color, exactly the same role forces[i].w plays for heat -
    // particle_integrate.comp reads it back and pulls colors[i] toward
    // it each step. Falls back to this particle's OWN current color (a
    // no-op pull) when there are no neighbors in range at all - an
    // isolated particle shouldn't drift toward black/zero just because
    // colorWeightTotal is 0.
    colorsAvg[i] = colorWeightTotal > 0.0 ? vec4(colorWeightedSum / colorWeightTotal, 1.0) : vec4(colorI, 1.0);
}
