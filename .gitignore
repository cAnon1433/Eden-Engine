# Build output - regenerated by CMake, never tracked.
/build/
/build-release/
/dist/

# Per-IDE/editor cruft.
.vs/
.vscode/
*.user

# macOS Finder metadata.
.DS_Store

# Windows debug/incremental-link byproducts (also stripped by the
# packaging script, but shouldn't be tracked even in a dev build/ dir
# if one is ever accidentally added).
*.pdb
*.ilk

# git-push-on-close helper's ephemeral credential relay - see
# "Run Eden (Mac).command"'s comment on GIT_ASKPASS. Should never
# exist on disk outside the few milliseconds a push is in flight, but
# ignored defensively in case a run is interrupted mid-push.
.eden_askpass_*
